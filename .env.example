# Copy to .env and fill in. Leave keys empty to run in offline/deterministic mode.

# LLM provider: auto (default) picks whichever key below is set – OpenAI first, then Azure, then Anthropic.
# Force one with: openai | anthropic | azure_openai | none   (define each variable ONCE – duplicates: last one wins)
LLM_PROVIDER=auto
# Leave empty for the provider's default model (openai: gpt-4o, anthropic: claude-sonnet-5)
LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure OpenAI (LLM_PROVIDER=azure_openai). Keys that do NOT start with "sk-" are Azure keys.
AZURE_OPENAI_ENDPOINT=              # e.g. https://<resource>.cognitiveservices.azure.com  (or .openai.azure.com)
AZURE_OPENAI_API_KEY=               # may also be left in OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=            # the DEPLOYMENT name in Azure AI Foundry, e.g. gpt-5.4

# Optional: override built image name (default <repo-name>:<run-id>)
IMAGE_NAME=

# GitHub – needed only for PRIVATE repositories.
# Create a fine-grained token: GitHub > Settings > Developer settings > Personal access tokens,
# repository access = the repos to scan, permission "Contents: Read-only".
GITHUB_TOKEN=
